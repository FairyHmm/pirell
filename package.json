{
  "name": "@pirell/monorepo",
  "author": "Fairy",
  "private": true,
  "description": "Monorepo for the Pirell library and showcase site.",
  "license": "ISC",
  "scripts": {
    "build": "pnpm -r --filter './packages/pirell/*' build",
    "test": "pnpm -r --filter './packages/pirell/*' test",
    "typecheck": "pnpm -r --filter './packages/pirell/*' typecheck && pnpm typecheck:tools",
    "typecheck:tools": "tsc",
    "lint": "node scripts/lint-report.mts",
    "lint:detail": "node scripts/lint-report.mts --detail",
    "types:core": "type-coverage --strict -p packages/pirell/core/tsconfig.json",
    "types:group": "type-coverage --strict -p packages/pirell/group/tsconfig.json",
    "types": "pnpm types:core && pnpm types:group",
    "jsr:check": "pnpm -r --filter './packages/pirell/*' jsr:check",
    "check": "pnpm typecheck && pnpm lint && pnpm types && pnpm test && pnpm -r --filter './packages/pirell/*' build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "jiti": "^2.7.0",
    "type-coverage": "^2.30.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0"
  }
}
