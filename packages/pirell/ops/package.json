{
  "name": "@pirell/ops",
  "author": "Fairy",
  "version": "0.1.0",
  "description": "Standard operations for pirell pipelines: grouping, broadcast, and native Array/Object fallthroughs.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "license": "ISC",
  "keywords": [
    "data",
    "pipeline",
    "ops",
    "group",
    "typescript"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "jsr:check": "deno publish --dry-run --no-prompt"
  },
  "dependencies": {
    "@pirell/core": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "@pirell/relational": "workspace:*"
  }
}
