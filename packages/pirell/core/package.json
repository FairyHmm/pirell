{
  "name": "@pirell/core",
  "author": "Fairy",
  "version": "0.1.0",
  "description": "Shape-aware pipeline engine that composes type-checked transformations over raw JavaScript data.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "license": "ISC",
  "keywords": [
    "data",
    "pipeline",
    "transform",
    "functional",
    "typescript",
    "fluent",
    "shape"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "perf": "tsx perf/probe.mts"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
