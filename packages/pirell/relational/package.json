{
  "name": "@pirell/relational",
  "author": "Fairy",
  "version": "0.1.0",
  "description": "Relational transformations including table and aggregate operations.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "license": "MPL-2.0",
  "keywords": [
    "data",
    "relational",
    "table",
    "aggregate",
    "typescript"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "perf:sql": "tsx perf/sql.mts",
    "jsr:check": "deno publish --dry-run --allow-dirty"
  },
  "dependencies": {
    "@pirell/core": "workspace:*",
    "@pirell/ops": "workspace:*",
    "nano-string-utils": "^0.28.1"
  },
  "devDependencies": {
    "@mdn/browser-compat-data": "^8.1.1",
    "@types/node": "^22.20.3",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
